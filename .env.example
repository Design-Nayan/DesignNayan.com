# ==============================================================================
# DESIGN NAYAN - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. DATABASE (Supabase PostgreSQL)
# Replace [YOUR-PASSWORD] and [YOUR-PROJECT-REF] with the owner's Supabase credentials.
# - DATABASE_URL uses the Supabase connection pooler (port 6543) for serverless scalability.
# - DIRECT_URL uses direct connection (port 5432) for running schema migrations.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# 2. SUPABASE PUBLIC ACCESS (For client & storage)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 3. AUTHENTICATION & SECURITY
# Generate a random 64-character string: openssl rand -base64 48
JWT_SECRET="design-nayan-ultra-secure-hmac-sha256-signing-key-change-in-production-2026"

# 4. INITIAL ADMIN BOOTSTRAP CREDENTIALS
# Used to log into the admin panel on first run before creating database users
ADMIN_INITIAL_EMAIL="admin@designnayan.com"
ADMIN_INITIAL_PASSWORD="DesignNayan@2026"
