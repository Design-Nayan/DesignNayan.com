// Design Nayan Production Database Schema
// Optimized for Next.js App Router + Supabase PostgreSQL (Connection Pooling)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// 1. ADMIN & AUTHENTICATION
// -----------------------------------------------------------------------------
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String    @default("Agency Director")
  passwordHash String
  role         String    @default("SUPERADMIN") // "SUPERADMIN" | "MANAGER" | "STAFF"
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_users")
}

// -----------------------------------------------------------------------------
// 2. INQUIRIES & LEAD PIPELINE
// -----------------------------------------------------------------------------
model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  service   String
  budget    String?
  message   String?  @db.Text
  location  String?  @default("India")
  status    String   @default("NEW") // "NEW" | "CONTACTED" | "CONVERTED" | "ARCHIVED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("inquiries")
}

// -----------------------------------------------------------------------------
// 3. FINANCIAL LEDGER & AUDIT TRAIL
// -----------------------------------------------------------------------------
model FinanceRecord {
  id             String   @id @default(cuid())
  clientName     String
  category       String // "Design & Architecture" | "Build & Construction" | "Branding & Creative" | "Stay & Property" | "Creator Campaigns" | "Web & Digital Development" | "Other Services"
  amount         Float // Amount paid / collected
  totalAmount    Float? // Total contract amount
  pendingAmount  Float?   @default(0) // Remaining milestone balance
  status         String // "Paid" | "Milestone" | "Pending"
  paymentMethod  String?  @default("Bank Transfer / UPI")
  date           String // Human date: "Today, 4:15 PM" or "2026-10-08"
  dueDate        String?
  clientPhone    String?
  projectDetails String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@map("finance_records")
}

model FinanceAuditLog {
  id          String   @id @default(cuid())
  action      String // "ADD" | "UPDATE" | "DELETE" | "PAYMENT_COLLECTED"
  description String   @db.Text
  timestamp   String // e.g. "Oct 8, 2026 at 04:30 PM"
  isoDate     String? // ISO string for chronological sorting
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("finance_audit_logs")
}

// -----------------------------------------------------------------------------
// 4. CREATOR NETWORK & ROSTER (CMS)
// -----------------------------------------------------------------------------
model Creator {
  id             String   @id // Unique slug, e.g. "kai-vance"
  name           String
  handle         String
  role           String
  category       String // "High Fashion & Luxury" | "Tech & Gadgets" | "Viral UGC & Short-Form" | ...
  formats        String[] // Array of deliverable formats
  tier           String // "Rising (25K-100K)" | "Prime (100K-500K)" | "Macro (500K-1.5M)" | "Icon (1.5M+)"
  location       String
  avatar         String
  featuredImage  String
  secondaryImage String?
  startingRate   String   @default("₹15,000")
  turnaroundDays Int      @default(3)
  bio            String   @db.Text
  pastBrands     String[]
  tags           String[]
  demographics   Json? // Audience metrics: topLocations, ageGroup, genderSplit
  caseStudies    Json? // Array of campaign case studies
  packages       Json? // Array of rate packages
  verified       Boolean  @default(true)
  featuredInHero Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([tier])
  @@index([isActive])
  @@map("creators")
}

// -----------------------------------------------------------------------------
// 5. STAYS & PROPERTY RENTALS (CMS)
// -----------------------------------------------------------------------------
model Stay {
  id            String   @id // e.g. "brahmaputra-resort"
  type          String // "stay" | "rental"
  title         String
  locality      String?
  city          String
  state         String?  @default("Assam")
  pricePerNight Float?
  monthlyRent   Float?
  bedrooms      Int?     @default(1)
  bathrooms     Int?     @default(1)
  guests        Int?     @default(2)
  featuredImage String
  images        String[]
  amenities     String[]
  isAvailable   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type])
  @@index([city])
  @@index([isAvailable])
  @@map("stays")
}

// -----------------------------------------------------------------------------
// 6. DYNAMIC CMS & SITE CONTENT
// -----------------------------------------------------------------------------
model SiteContent {
  key       String   @id // e.g. "about_page"
  data      Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("site_contents")
}

